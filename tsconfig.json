{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "react-isokit": ["./src/index.ts"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "examples/demo/src", "examples/demo/vite.config.ts", "tsup.config.ts", "vitest.config.ts"]
}
